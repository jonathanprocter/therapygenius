# Server Configuration
PORT=5000
NODE_ENV=development
TZ=America/New_York

# Database Configuration
# PostgreSQL connection string - Required for Neon/PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost:5432/therapygenius

# Security & Encryption
# AES-256-GCM encryption key (64 hex characters) for encrypting sensitive data like OAuth tokens
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here_replace_with_secure_key

# HIPAA Compliance
# Set to 'true' to enable HIPAA-compliant AI routing and audit logging
HIPAA_SAFE_AI=true

# AI Provider API Keys
# OpenAI API key for GPT models (document analysis, tagging, etc.)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic API key for Claude models (fallback AI provider)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google Calendar Integration
# OAuth 2.0 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Calendar Sync Configuration
# Date range for calendar sync (YYYY-MM-DD format)
CALENDAR_SYNC_START_DATE=2024-01-01
CALENDAR_SYNC_END_DATE=2025-12-31

# Maximum events to process per sync operation
MAX_EVENTS_PER_SYNC=1000

# Maximum sync requests per hour (rate limiting)
MAX_SYNC_REQUESTS_PER_HOUR=10

# Minimum time between sync operations in milliseconds
SYNC_RATE_LIMIT_MS=300000

# Google Calendar API quota limit (requests per day)
GOOGLE_CALENDAR_QUOTA_LIMIT=10000

# Circuit Breaker Configuration
# Number of failures before circuit breaker opens
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# Circuit breaker timeout in milliseconds
CIRCUIT_BREAKER_TIMEOUT_MS=60000
